{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Unseen Pay Docs",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://unseen.finance"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#7b2fff",
    "light": "#c4b5fd",
    "dark": "#1a0a3d"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#faf5ff",
      "dark": "#0c0518"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://unseen.finance"
      },
      {
        "label": "npm — @unseen_fi/sdk",
        "href": "https://www.npmjs.com/package/@unseen_fi/sdk"
      },
      {
        "label": "npm — @unseen_fi/ui",
        "href": "https://www.npmjs.com/package/@unseen_fi/ui"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "play",
        "pages": [
          "index",
          "quickstart",
          "concepts/architecture",
          "concepts/environments",
          "concepts/payment-lifecycle"
        ]
      },
      {
        "group": "Server SDK (@unseen_fi/sdk)",
        "icon": "server",
        "pages": [
          "sdk/server/installation",
          "sdk/server/client-payments",
          "sdk/server/webhooks-verify",
          "sdk/server/errors-types"
        ]
      },
      {
        "group": "React SDK (@unseen_fi/ui)",
        "icon": "layout-template",
        "pages": [
          "sdk/react/installation",
          "sdk/react/provider-button",
          "sdk/react/hooks-wallets"
        ]
      },
      {
        "group": "Webhooks",
        "icon": "webhook",
        "pages": ["webhooks/overview"]
      },
      {
        "group": "Guides",
        "icon": "book-open",
        "pages": ["guides/nextjs-checkout", "guides/webhooks-express"]
      },
      {
        "group": "Support",
        "icon": "life-buoy",
        "pages": ["troubleshooting", "changelog"]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://unseen.finance"
    }
  }
}
